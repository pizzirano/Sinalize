{
  "name": "theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development postcss ./src/styles.css -o ../static/css/dist/styles.css --watch",
    "build": "npm run clean && npm run build:css",
    "clean": "rimraf ../static/css/dist",
    "build:css": "cross-env NODE_ENV=production postcss ./src/styles.css -o ../static/css/dist/styles.css --minify"
  },
  "dependencies": {
    "tailwindcss": "^3.4.13",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.5",
    "postcss-nested": "^6.0.1",
    "postcss-simple-vars": "^7.0.1"
  },
  "browserslist": [
    "defaults"
  ]
}